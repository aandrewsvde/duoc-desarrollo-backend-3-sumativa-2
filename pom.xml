<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.duoc.bancoxyz</groupId>
    <artifactId>banco-xyz-bff</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>banco-xyz-bff</name>
    <description>Patron Backend for Frontend aplicado a los canales del Banco XYZ</description>

    <!--
      Estructura del reactor.

      Los tres BFF son modulos hermanos y desplegables por separado: ninguno
      depende de otro, y cada uno define su propio contrato de salida. Lo unico
      que comparten son dos modulos de infraestructura:

        seguridad-commons  primitivas de firma y validacion de JWT. Compartir el
                           algoritmo no compromete la independencia: cada canal
                           configura su propio emisor, audiencia, vigencia y
                           catalogo de roles.
        core-contrato      los tipos del contrato del core. Los publica el
                           productor y los consumen los canales, de modo que el
                           contrato no puede divergir sin romper la compilacion.
        core-client        el cliente HTTPS de ese contrato, con TLS, token de
                           servicio y tiempos de espera ya resueltos.

      Lo que NO se comparte es justamente lo que define a cada BFF: sus DTO de
      respuesta, sus reglas de transformacion y sus permisos.
    -->
    <modules>
        <module>shared/core-contrato</module>
        <module>shared/seguridad-commons</module>
        <module>shared/core-client</module>
        <module>core-banking-api</module>
        <module>bff-web</module>
        <module>bff-movil</module>
        <module>bff-cajero</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.6</jjwt.version>
        <springdoc.version>2.6.0</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.duoc.bancoxyz</groupId>
                <artifactId>seguridad-commons</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.duoc.bancoxyz</groupId>
                <artifactId>core-contrato</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.duoc.bancoxyz</groupId>
                <artifactId>core-client</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>

            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Presente en los cuatro servicios: el endpoint de salud es lo que
             permite a los scripts saber cuando un servicio esta realmente listo,
             en lugar de esperar un tiempo fijo y confiar en que alcance. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
